rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile and create it on signup
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Don't allow user deletion via client
    }

    // Pets collection
    match /pets/{petId} {
      // Anyone authenticated can read pets
      allow read: if isAuthenticated();
      // Only owners and rescue centers can create pets
      allow create: if isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'rescue_center']);
      // Only the pet owner can update/delete
      allow update, delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // Matches collection (swipe interests)
    match /matches/{matchId} {
      // Users can read matches they're part of
      allow read: if isAuthenticated() &&
        (resource.data.adopterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      // Adopters can create matches
      allow create: if isAuthenticated() &&
        request.resource.data.adopterId == request.auth.uid;
      // Only participants can update match status
      allow update: if isAuthenticated() &&
        (resource.data.adopterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      allow delete: if false;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read their conversations
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      // System creates conversations (done via cloud function ideally)
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if false;
      }
    }

    // Transport collection
    match /transport/{transportId} {
      // Participants can read transport info
      allow read: if isAuthenticated() &&
        (resource.data.adopterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      // Only after payment confirmation (handled by backend/cloud function)
      allow create: if false;
      allow update: if false; // Updates handled by backend
      allow delete: if false;
    }

    // Forms collection
    match /forms/{formId} {
      // Anyone can read forms
      allow read: if isAuthenticated();
      // Only owners and rescue centers can create forms
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid;
      // Only form creator can update/delete
      allow update, delete: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid;
    }

    // Form responses collection
    match /formResponses/{responseId} {
      // Form owner and adopter can read responses
      allow read: if isAuthenticated() &&
        (resource.data.adopterId == request.auth.uid ||
         resource.data.ownerId == request.auth.uid);
      // Adopters can submit responses
      allow create: if isAuthenticated() &&
        request.resource.data.adopterId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.adopterId == request.auth.uid;
      allow delete: if false;
    }
  }
}
