    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.1.5",
    "jsdom": "^29.0.0",
    "postcss": "^8.4.49",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.pelu.app",
    "productName": "Pelú",
    "files": [
