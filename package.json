    "gsap": "^3.14.2",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.574.0",
    "motion": "^12.23.12",
    "next": "^16.1.5",
    "next-i18next": "^15.3.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.2.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0",
